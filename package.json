{
    "name": "strecklista-backend",
    "version": "0.5.2",
    "description": "Backend for the \"strecklista\" developed by P.R.I.T.",
    "main": "bundle/server.js",
    "type": "commonjs",
    "scripts": {
        "build": "tsc && rollup --config rollup.config.mjs",
        "start": "node .",
        "dev": "docker compose up -d --build --force-recreate",
        "prod": "docker compose -f docker-compose.prod.yaml up -d",
        "format": "prettier . --write -l",
        "lint": "eslint",
        "fixlint": "eslint --fix",
        "prisma:generate": "prisma generate",
        "prisma:seed": "prisma db seed",
        "test": "echo \"Error: no test specified\" && exit 1"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/olillin/strecklista-backend.git"
    },
    "author": "olillin",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/olillin/strecklista-backend/issues"
    },
    "homepage": "https://github.com/olillin/strecklista-backend",
    "devEngines": {
        "runtime": {
            "name": "node",
            "version": "^24.19.0",
            "onFail": "error"
        },
        "packageManager": {
            "name": "pnpm",
            "version": "^11.24.0",
            "onFail": "download"
        }
    },
    "dependencies": {
        "@prisma/adapter-pg": "^7.10.0",
        "@prisma/client": "^7.10.0",
        "cors": "^2.8.6",
        "dotenv": "^17.4.2",
        "express": "^4.22.2",
        "express-rate-limit": "^7.5.1",
        "express-validator": "^7.3.2",
        "gammait": "^1.1.0",
        "jsonwebtoken": "^9.0.3",
        "pg": "^8.23.0",
        "prisma": "^7.10.0",
        "typescript": "^5.9.3"
    },
    "devDependencies": {
        "@eslint/compat": "^2.1.0",
        "@eslint/js": "^9.39.5",
        "@rollup/plugin-commonjs": "^29.0.3",
        "@rollup/plugin-json": "^6.1.0",
        "@rollup/plugin-node-resolve": "^16.0.3",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/pg": "^8.23.1",
        "eslint": "^10.9.1",
        "eslint-plugin-jsdoc": "^62.9.0",
        "globals": "^16.5.0",
        "prettier": "^3.9.6",
        "rollup": "^4.63.0",
        "tsx": "^4.23.12",
        "typescript-eslint": "^8.68.0"
    }
}
