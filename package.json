{
    "name": "strecklista-backend",
    "version": "0.5.2",
    "description": "Backend for the \"strecklista\" developed by P.R.I.T.",
    "main": "bundle/server.js",
    "type": "module",
    "scripts": {
        "postinstall": "copy-env-cli && prisma generate",
        "build": "rimraf bundle && rolldown -c",
        "start": "node .",
        "dev": "docker compose up --build --force-recreate -d && nodemon src/server.ts",
        "format": "oxfmt",
        "lint": "oxlint",
        "lint:fix": "oxlint --fix",
        "test": "echo \"Error: no test specified\" && exit 1"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/olillin/strecklista-backend.git"
    },
    "author": "olillin",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/olillin/strecklista-backend/issues"
    },
    "homepage": "https://github.com/olillin/strecklista-backend",
    "dependencies": {
        "@exodus/bytes": "^1.15.0",
        "@prisma/adapter-pg": "^7.4.1",
        "@prisma/client": "^7.4.1",
        "cors": "^2.8.5",
        "dotenv": "^17.3.1",
        "express": "^4.21.2",
        "express-rate-limit": "^7.5.0",
        "express-validator": "^7.2.1",
        "gammait": "^1.0.3",
        "jsonwebtoken": "^9.0.2",
        "pg": "^8.18.0",
        "prisma": "^7.4.1",
        "ulid": "^3.0.2"
    },
    "devDependencies": {
        "@types/cors": "^2.8.17",
        "@types/express": "^5.0.0",
        "@types/jsonwebtoken": "^9.0.9",
        "@types/node": "^25.6.0",
        "@types/pg": "^8.16.0",
        "copy-env-cli": "^1.0.0",
        "globals": "^16.0.0",
        "nodemon": "^3.1.14",
        "oxfmt": "^0.45.0",
        "oxlint": "^1.60.0",
        "rimraf": "^6.1.3",
        "rolldown": "1.0.0-rc.16",
        "tsx": "^4.21.0",
        "typescript": "^5.7.3"
    }
}
