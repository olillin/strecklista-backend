{
    "name": "strecklista-backend",
    "version": "0.5.2",
    "description": "Backend for the \"strecklista\" developed by P.R.I.T.",
    "main": "bundle/server.js",
    "type": "module",
    "scripts": {
        "postinstall": "(copy-env-cli || true) && (prisma generate || true)",
        "build": "rimraf bundle && rolldown -c",
        "start": "node .",
        "dev": "docker compose up -d && nodemon src/server.ts",
        "format": "oxfmt",
        "lint": "oxlint",
        "lint:fix": "oxlint --fix",
        "prisma:generate": "prisma generate",
        "prisma:seed": "prisma db seed",
        "test": "echo \"Error: no test specified\" && exit 1"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/olillin/strecklista-backend.git"
    },
    "author": "olillin",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/olillin/strecklista-backend/issues"
    },
    "homepage": "https://github.com/olillin/strecklista-backend",
    "devEngines": {
        "runtime": {
            "name": "node",
            "version": "^24.19.0",
            "onFail": "error"
        },
        "packageManager": {
            "name": "pnpm",
            "version": "^11.24.0",
            "onFail": "download"
        }
    },
    "dependencies": {
        "@exodus/bytes": "^1.15.0",
        "@prisma/adapter-pg": "^7.10.0",
        "@prisma/client": "^7.10.0",
        "cors": "^2.8.6",
        "dotenv": "^17.4.2",
        "express": "^4.22.2",
        "express-rate-limit": "^7.5.1",
        "express-validator": "^7.3.2",
        "gammait": "^1.1.0",
        "jsonwebtoken": "^9.0.3",
        "pg": "^8.23.0",
        "prisma": "^7.10.0",
        "ulid": "^3.0.2"
    },
    "devDependencies": {
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/node": "^25.6.0",
        "@types/pg": "^8.23.1",
        "copy-env-cli": "^1.0.0",
        "globals": "^16.5.0",
        "nodemon": "^3.1.14",
        "oxfmt": "^0.45.0",
        "oxlint": "^1.60.0",
        "rimraf": "^6.1.3",
        "rolldown": "1.2.6",
        "tsx": "^4.23.12",
        "typescript": "^5.9.3"
    }
}
